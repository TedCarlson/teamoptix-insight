{
  "name": "insight",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "artifact-ingest-poller": "node ./scripts/local-artifact-ingest-poller.js",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm build:worker",
    "build:worker": "pnpm --filter automation-worker build"
  }
}
