import { NextRequest, NextResponse } from "next/server";
import { getSupabaseServerClient } from "@/lib/supabase/server";

export const runtime = "nodejs";

function addDays(dateIso: string, days: number) {
  const date = new Date(`${dateIso}T00:00:00Z`);
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString().slice(0, 10);
}

function nameTokens(value: unknown) {
  return String(value ?? "")
    .toUpperCase()
    .replace(/[^A-Z0-9]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .split(" ")
    .filter(Boolean);
}

function dswNameParts(value: unknown) {
  const raw = String(value ?? "").trim();
  if (!raw) return { first: "", last: "" };

  if (raw.includes(",")) {
    const [lastRaw, restRaw = ""] = raw.split(",");
    const last = nameTokens(lastRaw)[0] ?? "";
    const first = nameTokens(restRaw)[0] ?? "";
    return { first, last };
  }

  const parts = nameTokens(raw);
  return {
    first: parts[0] ?? "",
    last: parts.length > 1 ? parts[parts.length - 1] : "",
  };
}

function scoreCandidate(unmatchedName: string, candidate: any) {
  const unmatched = dswNameParts(unmatchedName);
  const full = dswNameParts(candidate.full_name);
  const dswid = dswNameParts(candidate.dswid);

  let score = 0;

  if (unmatched.last && unmatched.last === full.last) score += 50;
  if (unmatched.first && unmatched.first === full.first) score += 40;

  if (unmatched.last && unmatched.last === dswid.last) score += 60;
  if (unmatched.first && unmatched.first === dswid.first) score += 50;

  const haystack = `${candidate.full_name ?? ""} ${candidate.dswid ?? ""}`.toUpperCase();
  for (const token of nameTokens(unmatchedName)) {
    if (token.length >= 3 && haystack.includes(token)) score += 5;
  }

  return score;
}

export async function GET(
  req: NextRequest,
  context: { params: Promise<{ slug: string }> }
) {
  try {
    const { slug } = await context.params;
    const weekEnd = req.nextUrl.searchParams.get("weekEnd");

    if (!weekEnd) {
      return NextResponse.json({ error: "weekEnd is required." }, { status: 400 });
    }

    const weekStart = addDays(weekEnd, -6);
    const supabase = await getSupabaseServerClient();

    const { data: company, error: companyError } = await supabase
      .from("companies")
      .select("id")
      .eq("company_slug", slug)
      .single();

    if (companyError || !company) {
      return NextResponse.json({ error: "Company not found." }, { status: 404 });
    }

    const { data: unmatchedRows, error: unmatchedError } = await supabase
      .schema("core")
      .from("payroll_activity_fact")
      .select("service_date, person_name, route_name, wa_number, actual_delivery_stops, actual_pickup_stops")
      .eq("company_id", company.id)
      .gte("service_date", weekStart)
      .lte("service_date", weekEnd)
      .is("roster_member_id", null)
      .not("person_name", "is", null)
      .neq("person_name", "")
      .order("person_name");

    if (unmatchedError) {
      return NextResponse.json({ error: unmatchedError.message }, { status: 500 });
    }

    const { data: rosterRows, error: rosterError } = await supabase
      .from("company_roster_view")
      .select("roster_member_id, full_name, employment_status, worker_type, dswid")
      .eq("company_id", company.id)
      .order("full_name");

    if (rosterError) {
      return NextResponse.json({ error: rosterError.message }, { status: 500 });
    }

    const grouped = new Map<string, any>();

    for (const row of unmatchedRows ?? []) {
      const key = String(row.person_name ?? "").trim();
      if (!key) continue;

      const item = grouped.get(key) ?? {
        person_name: key,
        rows: 0,
        service_dates: new Set<string>(),
        total_stops: 0,
        examples: [],
      };

      item.rows += 1;
      item.service_dates.add(row.service_date);
      item.total_stops += Number(row.actual_delivery_stops ?? 0) + Number(row.actual_pickup_stops ?? 0);

      if (item.examples.length < 5) {
        item.examples.push({
          service_date: row.service_date,
          route_name: row.route_name,
          wa_number: row.wa_number,
        });
      }

      grouped.set(key, item);
    }

    const roster = rosterRows ?? [];

    const unmatched = Array.from(grouped.values())
      .map((item) => {
        const suggestions = roster
          .map((candidate: any) => ({
            roster_member_id: candidate.roster_member_id,
            full_name: candidate.full_name,
            employment_status: candidate.employment_status,
            worker_type: candidate.worker_type,
            dswid: candidate.dswid,
            score: scoreCandidate(item.person_name, candidate),
          }))
          .filter((candidate) => candidate.score > 0)
          .sort((a, b) => b.score - a.score || String(a.full_name).localeCompare(String(b.full_name)))
          .slice(0, 8);

        return {
          ...item,
          service_dates: Array.from(item.service_dates).sort(),
          suggestions,
        };
      })
      .sort((a, b) => b.rows - a.rows || a.person_name.localeCompare(b.person_name));

    return NextResponse.json({
      company_id: company.id,
      week_start: weekStart,
      week_end: weekEnd,
      unmatched,
    });
  } catch (error) {
    return NextResponse.json(
      { error: error instanceof Error ? error.message : "Unmatched DSW query failed." },
      { status: 500 }
    );
  }
}
