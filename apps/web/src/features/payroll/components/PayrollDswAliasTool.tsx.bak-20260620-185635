"use client";

import { useEffect, useState } from "react";

type Suggestion = {
  roster_member_id: string;
  full_name: string;
  employment_status: string | null;
  worker_type: string | null;
  dswid: string | null;
  score: number;
};

type Unmatched = {
  person_name: string;
  rows: number;
  service_dates: string[];
  total_stops: number;
  examples: { service_date: string; route_name: string | null; wa_number: string | null }[];
  suggestions: Suggestion[];
};

export default function PayrollDswAliasTool({
  slug,
  weekEnd,
  onLinked,
}: {
  slug: string;
  weekEnd: string;
  onLinked: () => void;
}) {
  const [rows, setRows] = useState<Unmatched[]>([]);
  const [loading, setLoading] = useState(false);
  const [linkingKey, setLinkingKey] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  async function load() {
    if (!slug || !weekEnd) return;

    setLoading(true);
    setError(null);

    try {
      const res = await fetch(`/api/company/${slug}/payroll/dsw-unmatched?weekEnd=${weekEnd}`, {
        credentials: "include",
        cache: "no-store",
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data?.error ?? "Failed to load unmatched DSW rows.");
      }

      setRows(data?.unmatched ?? []);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to load unmatched DSW rows.");
      setRows([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void load();
  }, [slug, weekEnd]);

  async function linkAlias(unmatched: Unmatched, suggestion: Suggestion) {
    const key = `${unmatched.person_name}|${suggestion.roster_member_id}`;

    try {
      setLinkingKey(key);
      setError(null);

      const res = await fetch(`/api/company/${slug}/payroll/dsw-alias`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          alias: unmatched.person_name,
          roster_member_id: suggestion.roster_member_id,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data?.error ?? "Failed to link DSW alias.");
      }

      await load();
      onLinked();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to link DSW alias.");
    } finally {
      setLinkingKey(null);
    }
  }

  return (
    <div
      style={{
        border: "1px solid #e6edf5",
        borderRadius: 14,
        background: "#fff",
        overflow: "hidden",
      }}
    >
      <div
        style={{
          padding: 12,
          display: "flex",
          justifyContent: "space-between",
          gap: 10,
          alignItems: "center",
          borderBottom: "1px solid #e6edf5",
        }}
      >
        <div>
          <div style={{ fontWeight: 950, color: "#0f172a" }}>Unmatched DSW Aliases</div>
          <div style={{ color: "#64748b", fontSize: 12, fontWeight: 750 }}>
            Link FedEx driver strings to app roster records. Matched payroll will display roster names only.
          </div>
        </div>

        <button type="button" className="button" onClick={() => void load()} disabled={loading}>
          {loading ? "Loading..." : "Refresh"}
        </button>
      </div>

      {error ? (
        <div style={{ padding: 12, color: "#991b1b", fontWeight: 850 }}>{error}</div>
      ) : null}

      {!loading && rows.length === 0 ? (
        <div style={{ padding: 14, color: "#166534", fontWeight: 900 }}>
          No unmatched DSW driver strings for this week.
        </div>
      ) : null}

      <div style={{ display: "grid" }}>
        {rows.map((row) => (
          <div
            key={row.person_name}
            style={{
              padding: 12,
              borderTop: "1px solid #eef2f7",
              display: "grid",
              gap: 10,
            }}
          >
            <div style={{ display: "flex", justifyContent: "space-between", gap: 12, flexWrap: "wrap" }}>
              <div>
                <div style={{ fontWeight: 950, color: "#0f172a" }}>{row.person_name}</div>
                <div style={{ color: "#64748b", fontSize: 12, fontWeight: 800 }}>
                  {row.rows} row(s) · {row.total_stops} stops · {row.service_dates.join(", ")}
                </div>
              </div>

              <div style={{ color: "#64748b", fontSize: 12, fontWeight: 800 }}>
                {row.examples.map((example) => (
                  <span key={`${example.service_date}-${example.wa_number}`} style={{ marginLeft: 8 }}>
                    {example.service_date} · WA {example.wa_number ?? "—"} · {example.route_name ?? "—"}
                  </span>
                ))}
              </div>
            </div>

            <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
              {row.suggestions.length === 0 ? (
                <span style={{ color: "#991b1b", fontWeight: 850, fontSize: 12 }}>
                  No suggested roster matches.
                </span>
              ) : (
                row.suggestions.map((suggestion) => {
                  const key = `${row.person_name}|${suggestion.roster_member_id}`;

                  return (
                    <button
                      key={suggestion.roster_member_id}
                      type="button"
                      className="button"
                      disabled={linkingKey === key}
                      onClick={() => void linkAlias(row, suggestion)}
                      title={`Stored DSWID: ${suggestion.dswid ?? "none"}`}
                    >
                      {linkingKey === key ? "Linking..." : `Link to ${suggestion.full_name}`}
                      <span style={{ marginLeft: 6, color: "#64748b" }}>score {suggestion.score}</span>
                    </button>
                  );
                })
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
