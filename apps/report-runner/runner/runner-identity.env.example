# Copy to /etc/teamoptix/runners/<service-instance>.env with mode 0600.
# Enrollment supplies these values. Never place real credentials in the image.
RUNNER_KEY=r-company-slug-prod
RUNNER_ID=00000000-0000-4000-8000-000000000000
RUNNER_ASSIGNMENT_ID=00000000-0000-4000-8000-000000000000
RUNNER_COMMAND_POLL_SECONDS=5
RUNNER_SCHEDULE_POLL_SECONDS=60
RUNNER_SUCCESS_YIELD_SECONDS=60
RUNNER_CONTROL_BIND=127.0.0.1
RUNNER_CONTROL_PORT=8791
CONTINUOUS_RUNNER_SHADOW=1
